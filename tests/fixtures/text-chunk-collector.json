     ],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 4
     }
    },
    {
     "choices": [],
     "usage": {
      "prompt_tokens": 5,
      "completion_tokens": 4
     }
    }
   ],
   "payload": {
    "model": "fixture",
    "messages": [],
    "max_tokens": 4
